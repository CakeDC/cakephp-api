{
    "name": "cakedc/cakephp-api",
    "description": "Api plugin for CakePHP",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "api",
        "rest",
        "hateoas",
        "crud"
    ],
    "homepage": "https://github.com/CakeDC/cakephp-api",
    "license": "MIT",
    "authors": [
        {
            "name": "CakeDC",
            "homepage": "http://www.cakedc.com",
            "role": "Author"
        },
        {
            "name": "Others",
            "homepage": "https://github.com/CakeDC/cakephp-api/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/CakeDC/cakephp-api/issues",
        "source": "https://github.com/CakeDC/cakephp-api"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "cakephp/cakephp": "^5.1",
        "cakedc/users": "^16.0",
        "lcobucci/clock": "^2.2.0,<2.3.0",
        "lcobucci/jwt": "^5.5.0",
        "firebase/php-jwt": "^6.3 || ^7.0"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.14",
        "cakedc/cakephp-phpstan": "^4.3",
        "cakephp/cakephp-codesniffer": "^4.5",
        "cweagans/composer-patches": "^1.7",
        "endroid/qr-code": "^4",
        "google/recaptcha": "@stable",
        "laminas/laminas-diactoros": "^3.0",
        "league/flysystem-vfs": "^1.0",
        "phpunit/phpunit": "^11.5 || ^12.5",
        "phpstan/phpstan": "^2.2.2,<2.2.6",
        "rector/rector": "^2.5",
        "robthree/twofactorauth": "^1.6",
        "vlucas/phpdotenv": "^3.3",
        "web-auth/webauthn-lib": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "CakeDC\\Api\\": "src",
            "CakeDC\\Api\\Test\\Fixture\\": "tests\\Fixture"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakeDC\\Api\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
        }
    },
    "prefer-stable": true,
    "extra": {
        "patches": {
            "endroid/qr-code": {
                "Fix implicit nullable params in PHP 8.4": "patches/endroid-qr-code-nullable.patch"
            },
            "league/flysystem": {
                "Fix implicit nullable params in PHP 8.4": "patches/flysystem-nullable.patch"
            },
            "league/flysystem-vfs": {
                "Fix null passed to str_replace in PHP 8.1+": "patches/flysystem-vfs-null-str-replace.patch"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "fix-eol": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fix-lineendings.ps1",
        "test": "phpunit --stderr",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    }
}
